{
  "name": "agents-pane",
  "version": "0.7.0",
  "description": "A live pane in Claude Code that shows every subagent of the session: type, task, status, tool calls and elapsed time, plus a summary of the orchestration task list.",
  "author": { "name": "Bruno Cabral", "url": "https://github.com/bruno88cabral" },
  "homepage": "https://github.com/bruno88cabral/agents-pane",
  "repository": "https://github.com/bruno88cabral/agents-pane",
  "license": "MIT",
  "keywords": ["agents", "subagents", "orchestration", "pane", "monitoring"],
  "types": "./types/index.d.ts",
  "userConfig": {
    "language": {
      "type": "string",
      "title": "Language",
      "description": "Language of the pane labels",
      "default": "en",
      "options": ["en", "pt-BR"]
    }
  }
}
